{
  "mcpServers": {
    "yandex-s3": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "YANDEX_S3_ACCESS_KEY_ID",
        "-e",
        "YANDEX_S3_SECRET_ACCESS_KEY",
        "-e",
        "YANDEX_S3_POOL",
        "ghcr.io/stufently/yandex-s3-mcp-ai-cli:0.1.0@sha256:53ffda3fc5d5b3782442beb873bae1b739ca215ff9f1feb6e56e9d0205e18f2b"
      ],
      "env": {
        "YANDEX_S3_ACCESS_KEY_ID": "${YANDEX_S3_ACCESS_KEY_ID}",
        "YANDEX_S3_SECRET_ACCESS_KEY": "${YANDEX_S3_SECRET_ACCESS_KEY}",
        "YANDEX_S3_POOL": "${YANDEX_S3_POOL}"
      }
    }
  }
}
