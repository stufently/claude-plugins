{
  "name": "aviasales-mcp",
  "displayName": "Aviasales MCP",
  "version": "0.1.0",
  "description": "Find the cheapest flight for a route or a budget from Aviasales (Travelpayouts) cached fares. Read-only: the server has no tool that books or pays.",
  "author": {
    "name": "stufently"
  },
  "homepage": "https://github.com/stufently/aviasales-mcp",
  "repository": "https://github.com/stufently/claude-plugins",
  "license": "MIT",
  "keywords": [
    "aviasales",
    "travelpayouts",
    "flights",
    "travel",
    "mcp"
  ],
  "category": "travel",
  "skills": "./skills/",
  "rules": "./cursor/rules/",
  "commands": "./cursor/commands/",
  "mcpServers": "./cursor/mcp.json",
  "variables": {
    "type": "object",
    "properties": {
      "AVIASALES_API_TOKEN": {
        "type": "string",
        "title": "Travelpayouts API token",
        "description": "Your Travelpayouts (Aviasales) data API token."
      },
      "AVIASALES_MARKET": {
        "type": "string",
        "title": "Market",
        "description": "Two-letter market whose fare cache to read, e.g. ru, us, th.",
        "default": "ru"
      }
    },
    "required": [
      "AVIASALES_API_TOKEN"
    ]
  }
}
