{
  "mcpServers": {
    "mws-s3": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "MWS_S3_ACCESS_KEY_ID",
        "-e",
        "MWS_S3_SECRET_ACCESS_KEY",
        "-e",
        "MWS_S3_POOL",
        "ghcr.io/stufently/mws-s3-mcp-ai-cli:0.1.0@sha256:ceda902cee1862998f32134ed5f97c0357d87ee607bd610f2404bc22190bf722"
      ],
      "env": {
        "MWS_S3_ACCESS_KEY_ID": "${MWS_S3_ACCESS_KEY_ID}",
        "MWS_S3_SECRET_ACCESS_KEY": "${MWS_S3_SECRET_ACCESS_KEY}",
        "MWS_S3_POOL": "${MWS_S3_POOL}"
      }
    }
  }
}
