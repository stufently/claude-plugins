{
  "mcpServers": {
    "cloudru-s3": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "CLOUDRU_S3_ACCESS_KEY_ID",
        "-e",
        "CLOUDRU_S3_SECRET_ACCESS_KEY",
        "-e",
        "CLOUDRU_S3_POOL",
        "ghcr.io/stufently/cloudru-s3-mcp-ai-cli:0.1.0@sha256:95a6f25121e207b7327740209c1fa7b6fd7d93b411e8e882f0ebd8aab665d345"
      ],
      "env": {
        "CLOUDRU_S3_ACCESS_KEY_ID": "${CLOUDRU_S3_ACCESS_KEY_ID}",
        "CLOUDRU_S3_SECRET_ACCESS_KEY": "${CLOUDRU_S3_SECRET_ACCESS_KEY}",
        "CLOUDRU_S3_POOL": "${CLOUDRU_S3_POOL}"
      }
    }
  }
}
