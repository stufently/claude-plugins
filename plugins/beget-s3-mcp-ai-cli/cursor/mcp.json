{
  "mcpServers": {
    "beget-s3": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "BEGET_S3_ACCESS_KEY_ID",
        "-e",
        "BEGET_S3_SECRET_ACCESS_KEY",
        "-e",
        "BEGET_S3_POOL",
        "ghcr.io/stufently/beget-s3-mcp-ai-cli:0.1.0@sha256:cae961577f265753c2cf352a4b6cc6193db43ef4904dfc648cc1ea30d5925586"
      ],
      "env": {
        "BEGET_S3_ACCESS_KEY_ID": "${BEGET_S3_ACCESS_KEY_ID}",
        "BEGET_S3_SECRET_ACCESS_KEY": "${BEGET_S3_SECRET_ACCESS_KEY}",
        "BEGET_S3_POOL": "${BEGET_S3_POOL}"
      }
    }
  }
}
